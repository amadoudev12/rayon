# Adresse du backend Next.js (sans « / » final).
# En développement sur un vrai téléphone : l'adresse IP locale de l'ordinateur
# qui exécute `npm run dev`, PAS localhost (ex : http://192.168.1.85:3000).
# Émulateur Android : http://10.0.2.2:3000 — Simulateur iOS : http://localhost:3000
# En production : l'URL HTTPS de l'application web déployée.
EXPO_PUBLIC_API_URL=http://192.168.1.85:3000
